# ───────────────────────────────────────────────────────────────
#  Local SEO AI - Digital CRAO  ·  Variables de entorno
#  Copia este archivo a ".env" y ajusta los valores.
# ───────────────────────────────────────────────────────────────

# Conexión a PostgreSQL (obligatoria)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# URL pública de la aplicación. Si empieza con https://, las cookies de sesión se marcan "Secure".
APP_URL=http://localhost:3000
# (Opcional) fuerza el atributo Secure de la cookie: true | false
# COOKIE_SECURE=true

# Clave para cifrar secretos guardados en la base de datos (API keys de IA).
# Genera una con:  openssl rand -base64 32     ¡No la cambies después o perderás las API keys guardadas!
APP_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio

# Cuenta de demostración (demo@digitalcrao.com). Pon "false" para deshabilitarla en producción.
DEMO_ACCOUNT_ENABLED=true

# ── IA opcional (también configurable desde Configuración > IA) ──
# Proveedores: openai | anthropic | gemini | compatible
# AI_PROVIDER=openai
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=            # solo para "compatible" (https://…/v1)
# AI_ALLOW_PRIVATE_URLS=false

# ── Google Business Profile API (NO implementada en esta versión) ──
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
